#include <cstdint>

#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include "lib/matmul/matmul_intf.h"
#include "smem_shm_aicore_base_sdma.h"

#define MFMC2_AICORE_INLINE __attribute__((always_inline)) __aicore__ __inline__

MFMC2_AICORE_INLINE void Mfmc2CleanRegion(__gm__ uint8_t* base, uint64_t bytes)
{
    AscendC::GlobalTensor<int32_t> gm;
    for (uint64_t off = 0; off < bytes; off += 64) {
        gm.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(
                reinterpret_cast<uintptr_t>(base) + off),
            16);
        AscendC::DataCacheCleanAndInvalid<
            int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(gm);
    }
}

namespace {
using namespace AscendC;

using Mfmc2ANd = MatmulType<TPosition::GM, CubeFormat::ND, float16_t, false>;
using Mfmc2BNzT = MatmulType<TPosition::GM, CubeFormat::NZ, float16_t, true>;
using Mfmc2CNd = MatmulType<TPosition::GM, CubeFormat::ND, float16_t, false>;
using Mfmc2BiasF = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;

constexpr uint32_t MFMC2_N = 2048;
constexpr uint32_t MFMC2_K = 2048;
constexpr uint32_t MFMC2_BASE_N = 256;
constexpr uint32_t MFMC2_BASE_K = 64;
constexpr uint32_t MFMC2_CORES = 8;

constexpr MatmulQuantParams kMfmc2Quant = {false, false};
constexpr MatmulBatchParams kMfmc2Batch = {false, BatchMode::NONE};
constexpr MatmulFuncParams kMfmc2Func = {
    false, true, false, false, 0,
    IterateOrder::UNDEF, ScheduleType::INNER_PRODUCT, true, true};

#define MFMC2_PRODUCER_TILING(TAG, MB)                                      \
    constexpr MatmulShapeParams mfmc2Sp##TAG = {                            \
        MB / MFMC2_CORES, MFMC2_N, MFMC2_K, MB / MFMC2_CORES,              \
        MFMC2_BASE_N, MFMC2_BASE_K};                                        \
    constexpr MatmulConfig mfmc2Cfg##TAG =                                  \
        GetMMConfig<MatmulConfigMode::CONFIG_NORM>(                         \
            mfmc2Sp##TAG, kMfmc2Quant, kMfmc2Batch, kMfmc2Func);            \
    constexpr static MatmulApiStaticTiling mfmc2St##TAG =                   \
        GetMatmulApiTiling<Mfmc2ANd, Mfmc2BNzT, Mfmc2CNd, Mfmc2BiasF>(      \
            mfmc2Cfg##TAG, Impl::L1_SIZE);

MFMC2_PRODUCER_TILING(256, 256)
MFMC2_PRODUCER_TILING(512, 512)
MFMC2_PRODUCER_TILING(1024, 1024)

constexpr uint64_t MFMC2_READY_STRIDE_BYTES = 64;
constexpr uint64_t MFMC2_READY_POLL_MAX_ITER = 100000000ULL;
constexpr uint64_t MFMC2_CREDIT_TAG = 0x4D46435245444954ULL;

enum Mfmc2ProtocolStatus : uint64_t {
    MFMC2_STATUS_OK = 0,
    MFMC2_STATUS_READY_TIMEOUT = 1,
    MFMC2_STATUS_SIGNAL_FAILED = 2,
    MFMC2_STATUS_QUIET_FAILED = 3,
    MFMC2_STATUS_WAIT_FAILED = 4,
    MFMC2_STATUS_MAIL_MISMATCH = 5,
    MFMC2_STATUS_CREDIT_MISMATCH = 6,
    MFMC2_STATUS_ACK_FAILED = 7,
};

MFMC2_AICORE_INLINE void Mfmc2FlushLine(__gm__ uint8_t* cell)
{
    AscendC::GlobalTensor<int32_t> t;
    t.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cell), 16);
    AscendC::DataCacheCleanAndInvalid<
        int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(t);
}

MFMC2_AICORE_INLINE void Mfmc2Fail(__gm__ uint8_t* protocol_status,
                                    uint64_t code)
{
    *reinterpret_cast<__gm__ volatile uint64_t*>(protocol_status) = code;
    Mfmc2FlushLine(protocol_status);
    AscendC::Trap();
}

MFMC2_AICORE_INLINE __gm__ uint8_t* Mfmc2ReadyCell(
    __gm__ uint8_t* control, uint32_t batch_index, uint32_t core)
{
    const uint64_t cell =
        (static_cast<uint64_t>(batch_index) * MFMC2_CORES + core) *
        MFMC2_READY_STRIDE_BYTES;
    return control + cell;
}

MFMC2_AICORE_INLINE void Mfmc2WriteReady(
    __gm__ uint8_t* control, uint32_t batch_index, uint32_t core,
    uint32_t generation)
{
    __gm__ uint8_t* cell = Mfmc2ReadyCell(control, batch_index, core);
    *reinterpret_cast<__gm__ volatile uint64_t*>(cell) = generation;
    Mfmc2FlushLine(cell);
}

MFMC2_AICORE_INLINE bool Mfmc2WaitReady(
    __gm__ uint8_t* control, uint32_t batch_index, uint32_t core,
    uint32_t generation)
{
    __gm__ uint8_t* cell = Mfmc2ReadyCell(control, batch_index, core);
    AscendC::GlobalTensor<int32_t> t;
    t.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cell), 16);
    for (uint64_t iter = 0; iter < MFMC2_READY_POLL_MAX_ITER; ++iter) {
        AscendC::DataCacheCleanAndInvalid<
            int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE>(t);
        if (*reinterpret_cast<__gm__ volatile uint64_t*>(cell) == generation) {
            return true;
        }
        if (iter >= 4096) __asm__ __volatile__("" ::: "memory");
    }
    return false;
}

template <const MatmulApiStaticTiling& ST, uint32_t BATCH_M>
__global__ __aicore__ void Mfmc2DirectProducerKernel(
    __gm__ uint8_t* gva, __gm__ uint8_t* x_gm, __gm__ uint8_t* w_gm,
    __gm__ uint8_t* send_arena, __gm__ uint8_t* peer_recv_arena,
    __gm__ uint8_t* producer_control, __gm__ uint8_t* protocol_status,
    uint32_t batch_index, uint32_t generation, uint64_t batch_bytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (generation == 0) return;

    const uint32_t block = GetBlockIdx();
    if (block >= MFMC2_CORES) return;

    __gm__ uint8_t* slot =
        send_arena + static_cast<uint64_t>(batch_index) * batch_bytes;
    constexpr uint32_t kRowsPerCore = BATCH_M / MFMC2_CORES;
    const uint64_t row_off = static_cast<uint64_t>(block) * kRowsPerCore;

    TPipe pipe;
    TCubeTiling rt{};
    rt.usedCoreNum = MFMC2_CORES;
    Matmul<Mfmc2ANd, Mfmc2BNzT, Mfmc2CNd, Mfmc2BiasF, ST> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &rt);
    TBuf<> ub_buf;
    pipe.InitBuffer(ub_buf, TOTAL_UB_SIZE);
    mm.SetLocalWorkspace(ub_buf.Get<uint8_t>());

    GlobalTensor<float16_t> a_gm;
    GlobalTensor<float16_t> b_gm;
    GlobalTensor<float16_t> c_gm;
    a_gm.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(x_gm) + row_off * MFMC2_K,
        kRowsPerCore * MFMC2_K);
    b_gm.SetGlobalBuffer(reinterpret_cast<__gm__ float16_t*>(w_gm),
                         MFMC2_N * MFMC2_K);
    c_gm.SetGlobalBuffer(
        reinterpret_cast<__gm__ float16_t*>(
            slot + row_off * MFMC2_N * sizeof(float16_t)),
        kRowsPerCore * MFMC2_N);

    mm.SetTensorA(a_gm, false);
    mm.SetTensorB(b_gm, true);
    mm.SetOrgShape(kRowsPerCore, MFMC2_N, MFMC2_K, MFMC2_K, MFMC2_N);
    mm.IterateAll(c_gm);

    Mfmc2CleanRegion(
        slot + row_off * MFMC2_N * sizeof(float16_t),
        static_cast<uint64_t>(kRowsPerCore) * MFMC2_N * sizeof(float16_t));
    Mfmc2WriteReady(producer_control, batch_index, block, generation);

    if (block != 0) return;
    for (uint32_t core = 0; core < MFMC2_CORES; ++core) {
        if (!Mfmc2WaitReady(producer_control, batch_index, core, generation)) {
            Mfmc2Fail(protocol_status, MFMC2_STATUS_READY_TIMEOUT);
            return;
        }
    }

    __gm__ uint8_t* dst =
        peer_recv_arena + static_cast<uint64_t>(batch_index) * batch_bytes;
    if (!smem_shm_sdma_signal(gva, slot, dst, batch_bytes, batch_index)) {
        Mfmc2Fail(protocol_status, MFMC2_STATUS_SIGNAL_FAILED);
    }
}
}  // namespace

extern "C" __global__ __aicore__ void mfmc2WaitBatchKernel(
    __gm__ uint8_t* gva, uint64_t expected_recv_base,
    __gm__ uint8_t* protocol_status, uint32_t batch_index,
    uint64_t batch_bytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() != 0 || batch_bytes == 0) return;
    smem_shm_sdma_mail_t mail = smem_shm_sdma_wait(gva);
    if (mail.status != SMEM_SHM_SDMA_MAIL_OK) {
        Mfmc2Fail(protocol_status, MFMC2_STATUS_WAIT_FAILED);
        return;
    }
    const uint64_t expected_dst =
        expected_recv_base + static_cast<uint64_t>(batch_index) * batch_bytes;
    if (mail.dst != expected_dst || mail.len != batch_bytes ||
        mail.imm != batch_index) {
        Mfmc2Fail(protocol_status, MFMC2_STATUS_MAIL_MISMATCH);
    }
}

constexpr uint32_t MFMC2_ADD_MAX_BLOCKS = 8;
constexpr uint32_t MFMC2_ADD_TILE_ELEMS = 16384;
constexpr uint64_t MFMC2_ADD_SLICE_ALIGN = 128;

extern "C" __global__ __aicore__ void mfmc2AddKernel(
    __gm__ uint8_t* out_gm, __gm__ uint8_t* send_gm,
    __gm__ uint8_t* recv_gm, uint64_t elems, uint32_t block_count)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() >= block_count || elems == 0) return;

    const uint64_t slice =
        ((elems + block_count - 1) / block_count + MFMC2_ADD_SLICE_ALIGN - 1) &
        ~(MFMC2_ADD_SLICE_ALIGN - 1);
    const uint64_t begin = static_cast<uint64_t>(GetBlockIdx()) * slice;
    if (begin >= elems) return;
    const uint64_t end = begin + slice < elems ? begin + slice : elems;

    TPipe pipe;
    TQue<TPosition::VECIN, 2> in_a;
    TQue<TPosition::VECIN, 2> in_b;
    TQue<TPosition::VECOUT, 2> out_q;
    pipe.InitBuffer(in_a, 2, MFMC2_ADD_TILE_ELEMS * sizeof(float16_t));
    pipe.InitBuffer(in_b, 2, MFMC2_ADD_TILE_ELEMS * sizeof(float16_t));
    pipe.InitBuffer(out_q, 2, MFMC2_ADD_TILE_ELEMS * sizeof(float16_t));

    __gm__ float16_t* out_h = reinterpret_cast<__gm__ float16_t*>(out_gm);
    __gm__ float16_t* send_h = reinterpret_cast<__gm__ float16_t*>(send_gm);
    __gm__ float16_t* recv_h = reinterpret_cast<__gm__ float16_t*>(recv_gm);

    for (uint64_t off = begin; off < end; off += MFMC2_ADD_TILE_ELEMS) {
        const uint32_t n = static_cast<uint32_t>(
            end - off < MFMC2_ADD_TILE_ELEMS ? end - off : MFMC2_ADD_TILE_ELEMS);
        GlobalTensor<float16_t> send_view;
        send_view.SetGlobalBuffer(send_h + off, n);
        GlobalTensor<float16_t> recv_view;
        recv_view.SetGlobalBuffer(recv_h + off, n);
        GlobalTensor<float16_t> out_view;
        out_view.SetGlobalBuffer(out_h + off, n);

        LocalTensor<float16_t> a = in_a.AllocTensor<float16_t>();
        DataCopy(a, send_view, n);
        in_a.EnQue(a);
        LocalTensor<float16_t> b = in_b.AllocTensor<float16_t>();
        DataCopy(b, recv_view, n);
        in_b.EnQue(b);

        LocalTensor<float16_t> va = in_a.DeQue<float16_t>();
        LocalTensor<float16_t> vb = in_b.DeQue<float16_t>();
        LocalTensor<float16_t> o = out_q.AllocTensor<float16_t>();
        Add(o, va, vb, n);
        out_q.EnQue(o);

        LocalTensor<float16_t> vo = out_q.DeQue<float16_t>();
        DataCopy(out_view, vo, n);
        out_q.FreeTensor(vo);
        in_a.FreeTensor(va);
        in_b.FreeTensor(vb);
    }
}

extern "C" __global__ __aicore__ void mfmc2AckKernel(
    __gm__ uint8_t* gva, __gm__ uint8_t* ack_slot,
    __gm__ uint8_t* peer_ack_slot, __gm__ uint8_t* protocol_status,
    uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() != 0 || enable == 0) return;
    Mfmc2CleanRegion(ack_slot, 8);
    if (!smem_shm_sdma_signal(gva, ack_slot, peer_ack_slot, 8,
                              MFMC2_CREDIT_TAG)) {
        Mfmc2Fail(protocol_status, MFMC2_STATUS_ACK_FAILED);
    }
}

extern "C" __global__ __aicore__ void mfmc2GateKernel(
    __gm__ uint8_t* gva, uint64_t expected_credit_dst,
    __gm__ uint8_t* protocol_status, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() != 0 || enable == 0) return;
    smem_shm_sdma_mail_t mail = smem_shm_sdma_wait(gva);
    if (mail.status != SMEM_SHM_SDMA_MAIL_OK ||
        mail.dst != expected_credit_dst || mail.len != 8 ||
        mail.imm != MFMC2_CREDIT_TAG) {
        Mfmc2Fail(protocol_status, MFMC2_STATUS_CREDIT_MISMATCH);
    }
}

extern "C" __global__ __aicore__ void mfmc2QuietKernel(
    __gm__ uint8_t* gva, __gm__ uint8_t* protocol_status, uint32_t enable)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AICORE);
    if (GetBlockIdx() != 0 || enable == 0) return;
    if (!smem_shm_sdma_quiet(gva)) {
        Mfmc2Fail(protocol_status, MFMC2_STATUS_QUIET_FAILED);
    }
}

#define MFMC2_PRODUCER_LAUNCH_CASE(batchm)                                   \
    case batchm: {                                                           \
        Mfmc2DirectProducerKernel<mfmc2St##batchm, batchm>                   \
            <<<MFMC2_CORES, 0, stream>>>(                                    \
                reinterpret_cast<uint8_t*>(pool_base),                       \
                reinterpret_cast<uint8_t*>(x),                               \
                reinterpret_cast<uint8_t*>(w),                               \
                reinterpret_cast<uint8_t*>(send_arena),                      \
                reinterpret_cast<uint8_t*>(peer_recv_arena),                 \
                reinterpret_cast<uint8_t*>(producer_control),                \
                reinterpret_cast<uint8_t*>(protocol_status),                 \
                batch_index, generation, batch_bytes);                       \
        return 0;                                                            \
    }

extern "C" int mfmc2_device_launch_direct_producer_async(
    uint64_t pool_base, uint64_t x, uint64_t w, uint64_t send_arena,
    uint64_t peer_recv_arena, uint32_t batch_m, uint32_t batch_index,
    uint32_t generation, uint64_t batch_bytes, uint64_t producer_control,
    uint64_t protocol_status, aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || x == 0 || w == 0 ||
        send_arena == 0 || peer_recv_arena == 0 || producer_control == 0 ||
        protocol_status == 0 || generation == 0 || batch_bytes == 0 ||
        batch_bytes != static_cast<uint64_t>(batch_m) * MFMC2_N *
                           sizeof(float16_t)) {
        return -1;
    }
    switch (batch_m) {
        MFMC2_PRODUCER_LAUNCH_CASE(256)
        MFMC2_PRODUCER_LAUNCH_CASE(512)
        MFMC2_PRODUCER_LAUNCH_CASE(1024)
        default: return -1;
    }
}
#undef MFMC2_PRODUCER_LAUNCH_CASE

extern "C" int mfmc2_device_wait_batch_async(
    uint64_t pool_base, uint64_t expected_recv_base, uint32_t batch_index,
    uint64_t batch_bytes, uint64_t protocol_status, aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || expected_recv_base == 0 ||
        batch_bytes == 0 || protocol_status == 0) {
        return -1;
    }
    mfmc2WaitBatchKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(pool_base), expected_recv_base,
        reinterpret_cast<uint8_t*>(protocol_status), batch_index, batch_bytes);
    return 0;
}

#define MFMC2_PRODUCER_WARMUP_CASE(batchm)                                  \
    case batchm:                                                            \
        Mfmc2DirectProducerKernel<mfmc2St##batchm, batchm>                  \
            <<<MFMC2_CORES, 0, stream>>>(                                   \
                reinterpret_cast<uint8_t*>(pool_base),                      \
                reinterpret_cast<uint8_t*>(pool_base),                      \
                reinterpret_cast<uint8_t*>(pool_base),                      \
                reinterpret_cast<uint8_t*>(pool_base),                      \
                reinterpret_cast<uint8_t*>(pool_base),                      \
                reinterpret_cast<uint8_t*>(pool_base),                      \
                reinterpret_cast<uint8_t*>(pool_base), 0, 0, batch_bytes); \
        return 0;

extern "C" int mfmc2_device_warmup_producer_async(
    uint64_t pool_base, uint32_t batch_m, uint64_t batch_bytes,
    aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || batch_bytes == 0 ||
        batch_bytes != static_cast<uint64_t>(batch_m) * MFMC2_N *
                           sizeof(float16_t)) {
        return -1;
    }
    switch (batch_m) {
        MFMC2_PRODUCER_WARMUP_CASE(256)
        MFMC2_PRODUCER_WARMUP_CASE(512)
        MFMC2_PRODUCER_WARMUP_CASE(1024)
        default: return -1;
    }
}
#undef MFMC2_PRODUCER_WARMUP_CASE

extern "C" int mfmc2_device_warmup_waiter_async(uint64_t pool_base,
                                                  aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0) return -1;
    mfmc2WaitBatchKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(pool_base), pool_base,
        reinterpret_cast<uint8_t*>(pool_base), 0, 0);
    return 0;
}

extern "C" int mfmc2_device_add_async(uint64_t out, uint64_t send_arena,
                                        uint64_t recv_arena, uint64_t elems,
                                        uint32_t block_count,
                                        aclrtStream stream)
{
    if (stream == nullptr || out == 0 || send_arena == 0 || recv_arena == 0 ||
        elems == 0 || (elems % MFMC2_ADD_SLICE_ALIGN) != 0 ||
        block_count == 0 || block_count > MFMC2_ADD_MAX_BLOCKS) {
        return -1;
    }
    mfmc2AddKernel<<<MFMC2_ADD_MAX_BLOCKS, 0, stream>>>(
        reinterpret_cast<uint8_t*>(out), reinterpret_cast<uint8_t*>(send_arena),
        reinterpret_cast<uint8_t*>(recv_arena), elems, block_count);
    return 0;
}

extern "C" int mfmc2_device_ack_async(
    uint64_t pool_base, uint64_t ack_slot, uint64_t peer_ack_slot,
    uint64_t protocol_status, uint32_t enable, aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || ack_slot == 0 ||
        peer_ack_slot == 0 || protocol_status == 0 || enable > 1) return -1;
    mfmc2AckKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(pool_base), reinterpret_cast<uint8_t*>(ack_slot),
        reinterpret_cast<uint8_t*>(peer_ack_slot),
        reinterpret_cast<uint8_t*>(protocol_status), enable);
    return 0;
}

extern "C" int mfmc2_device_gate_async(
    uint64_t pool_base, uint64_t expected_credit_dst,
    uint64_t protocol_status, uint32_t enable, aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || expected_credit_dst == 0 ||
        protocol_status == 0 || enable > 1) return -1;
    mfmc2GateKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(pool_base), expected_credit_dst,
        reinterpret_cast<uint8_t*>(protocol_status), enable);
    return 0;
}

extern "C" int mfmc2_device_quiet_async(
    uint64_t pool_base, uint64_t protocol_status, uint32_t enable,
    aclrtStream stream)
{
    if (stream == nullptr || pool_base == 0 || protocol_status == 0 ||
        enable > 1) return -1;
    mfmc2QuietKernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(pool_base),
        reinterpret_cast<uint8_t*>(protocol_status), enable);
    return 0;
}

extern "C" int mfmc2_device_warmup_add_async(uint64_t arena,
                                               aclrtStream stream)
{
    if (stream == nullptr || arena == 0) return -1;
    mfmc2AddKernel<<<MFMC2_ADD_MAX_BLOCKS, 0, stream>>>(
        reinterpret_cast<uint8_t*>(arena), reinterpret_cast<uint8_t*>(arena),
        reinterpret_cast<uint8_t*>(arena), 0, 1);
    return 0;
}
